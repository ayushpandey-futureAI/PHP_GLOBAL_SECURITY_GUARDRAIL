# ==============================================================================
# SNUFFLEUPAGUS HARDENED RULES: LEGACY PROCEDURAL MONOLITHS
# ==============================================================================
# Tailored for legacy PHP 5.4, 5.6, 7.0-7.4 codebases running in modernized PHP 8.x
# environments with mysql_* polyfill shims.
# ==============================================================================

# [1] Drop Dynamic Code Execution
sp.disable_function.function("eval").drop();
sp.disable_function.function("create_function").drop();

# [2] Shell Command Protection
sp.disable_function.function("system").drop();
sp.disable_function.function("shell_exec").drop();
sp.disable_function.function("passthru").drop();
sp.disable_function.function("proc_open").drop();
sp.disable_function.function("popen").drop();

# [3] Stream Wrapper Neutralization
sp.disable_function.function("include").param("path").regex("^(?:php|data|phar|expect|zip):\/\/").drop();
sp.disable_function.function("require").param("path").regex("^(?:php|data|phar|expect|zip):\/\/").drop();
sp.disable_function.function("include_once").param("path").regex("^(?:php|data|phar|expect|zip):\/\/").drop();
sp.disable_function.function("require_once").param("path").regex("^(?:php|data|phar|expect|zip):\/\/").drop();

# [4] Insecure Deserialization Safeguards
sp.unserialize.reject_class("stdClass").drop();
